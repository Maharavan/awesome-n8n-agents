# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change_me_strong_password

# ── n8n Security ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (keep this secret & stable)
N8N_ENCRYPTION_KEY=change_me_32_byte_hex_string

# ── Webhook URL ──────────────────────────────────────────────────────
# For local dev use http://localhost:5678/
# For tunnels (ngrok, cloudflare, etc.) set your public URL here
WEBHOOK_URL=http://localhost:5678/

# ── Misc ──────────────────────────────────────────────────────────────
TIMEZONE=UTC
N8N_LOG_LEVEL=info
