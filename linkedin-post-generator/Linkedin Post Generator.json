    {
      "parameters": {
        "jsCode": "const agentOutput = $('Content Generation Agent').first().json.output || '';\nconst topicMatch = agentOutput.match(/TOPIC:\\s*(.+)/i);\nconst draftMatch = agentOutput.match(/POST DRAFT:\\s*([\\s\\S]+)/i);\nconst topic = topicMatch ? topicMatch[1].trim() : '';\nconst postDraft = draftMatch ? draftMatch[1].trim() : '';\nconst from = $input.first().json.from;\nconst source = $input.first().json.source;\nconst rowNumber = $input.first().json.rowNumber;\nreturn [{ json: { topic, postDraft, from, source, rowNumber } }];"
      },
