      "parameters": {
        "promptType": "define",
        "text": "=Generate a professional LinkedIn post for the following topic:\n\n\"{{ $json.userMessage }}\"\n\nOutput EXACTLY:\n\nTOPIC: <short one-line topic summary>\n\nPOST DRAFT: <full LinkedIn post content>\n\nRequirements:\n* Human, natural, engaging tone with relevant emojis.\n* Short readable paragraphs, strong hook, real insights.\n* End with a question or CTA.\n* Include 5–10 relevant hashtags.\n* No extra text outside the format.",
        "options": {
          "systemMessage": "You are an expert LinkedIn content writer. Write engaging posts under 1300 characters. Strong hook, CTA at end. Output ONLY:\nTOPIC: <summary>\nPOST DRAFT:\n<content>\nNo preamble or extra text."
        }
      },
